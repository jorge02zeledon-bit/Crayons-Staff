# Copy to .env.local for local work. On Vercel, add these under Project > Settings > Environment Variables.

# Signs the sign-in cookies. Any long random string (e.g. `openssl rand -base64 32`). Required in production.
AUTH_SECRET=

# Lets any admin account sign in with this password instead of their PIN (recovery). Optional but recommended.
ADMIN_PASSWORD=

# Unlocks the kiosk tablet for 90 days. Falls back to ADMIN_PASSWORD when unset.
KIOSK_PASSWORD=

# Shown on the sign-in screen and badges.
SCHOOL_NAME=Crayons

# Time zone used for "today", break times and the hours report.
SCHOOL_TZ=America/New_York

# Storage. On Vercel, add Upstash Redis from the project's Storage tab; it sets these for you.
# Without them, data is kept in a local file (dev) or temporary server storage (lost on deploy).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
